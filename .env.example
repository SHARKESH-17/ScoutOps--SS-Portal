# ScoutOps environment template.
# Copy to .env (cp .env.example .env) and change the placeholder values.
# NEVER commit the real .env file to Git.

NODE_ENV=development
PORT=3000

# Database. DB_HOST=postgres is the Docker Compose service name.
# For a Node process running directly on your host use DB_HOST=localhost.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=scoutops
DB_USER=scoutops_user
DB_PASSWORD=change_me

# Host port the application is published on (docker compose / production).
APP_PORT=3000

# Docker image tag used by docker-compose.prod.yml, deploy.sh and rollback.sh.
SCOUTOPS_VERSION=1.0.0

# Grafana admin login (monitoring stack). Choose a strong password.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me
